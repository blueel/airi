<?xml version="1.0" encoding="utf-8"?>
<!--
  The public AIRI origin uses a self-signed certificate for airi.example.
  Android WebView rejects that certificate without a trust anchor, so the
  memory server and the other proxied providers fail with "Failed to fetch".
  This file trusts the pinned certificate for that one host only.

  The same host serves the update manifest on port 9160 and Breeze TTS on
  port 9150 over plain HTTP. Network Security Config applies a domain rule
  to every port, so cleartext must stay allowed for this host. HTTPS checks
  still use the pinned certificate and the system anchors.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">airi.example</domain>
        <trust-anchors>
            <certificates src="@raw/airi_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>