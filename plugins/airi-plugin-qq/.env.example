# --- AIRI channel server (stage-web / stage-tamagotchi server runtime) ---
AIRI_SERVER_URL=ws://localhost:6121/ws
AIRI_SERVER_TOKEN=

# --- Reverse WebSocket that NapCat / LLOneBot connects to ---
QQ_ONEBOT_HOST=127.0.0.1
QQ_ONEBOT_PORT=6700
QQ_ONEBOT_PATH=/onebot
QQ_ONEBOT_TOKEN=

# --- Behaviour ---
# true: a group message needs a mention of the bot, or the trigger prefix below.
QQ_GROUP_REQUIRE_MENTION=true
# Empty means no extra prefix. Example: "/airi" or "爱莉"
QQ_TRIGGER_PREFIX=
# Comma separated group ids. Empty means every group.
QQ_ALLOWED_GROUPS=
# Comma separated member ids allowed in private chat. Empty means every member.
QQ_ALLOWED_USERS=
# Upper bound of one outgoing QQ message, in characters.
QQ_MAX_CHUNK_LENGTH=1200
